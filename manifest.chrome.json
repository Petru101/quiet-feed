{
  "manifest_version": 3,
  "name": "Quiet Feed: Hide Posts by Keyword",
  "version": "2.11",
  "description": "Hide whole posts containing your chosen words on YouTube, Reddit and X. Hidden in place: feeds don't reload, video stays silent.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "optional_host_permissions": [
    "https://i.ytimg.com/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://cf.preview.redd.it/*",
    "https://external-preview.redd.it/*",
    "https://pbs.twimg.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "src/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": [
        "src/compat.js",
        "src/common.js",
        "src/content.js"
      ],
      "css": [
        "src/hidden.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Quiet Feed",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
